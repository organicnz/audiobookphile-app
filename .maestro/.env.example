# Maestro e2e environment — copy to .maestro/.env and fill in.
# The runner (run.sh) sources this before invoking `maestro test`.

# Server the app connects to (web origin that proxies /api/* and /login).
SERVER_URL=https://audiobookphile.vercel.app

# Test account WITHOUT 2FA enrolled (the password-login flow asserts the
# library home, the 2FA challenge sheet would divert it).
TEST_EMAIL=e2e@audiobookphile.test
TEST_PASSWORD=

# Only for 12_auth_magic_link_deeplink.yaml: a fresh deep-link URL of the form
# audiobookphile://auth/callback?accessToken=...&refreshToken=...&userId=...
# Mint one against prod from the web repo, or leave empty to skip that flow.
MAGIC_LINK_URL=
